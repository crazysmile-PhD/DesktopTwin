<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
		<!-- Keep single-file analyzer dependencies identical during restore and publish. -->
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
		<RootNamespace>DesktopTwin</RootNamespace>
		<AssemblyName>DesktopTwin</AssemblyName>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- 图标取自系统远程桌面客户端，由 build/make-icon.ps1 原样重打包（多尺寸、零缩放） -->
		<ApplicationIcon>Assets\DesktopTwin.ico</ApplicationIcon>
		<!-- WPF 的 DPI 感知由 app.manifest 声明；WinForms 的 WFO0003 分析器不适用于本项目的混合场景 -->
		<NoWarn>$(NoWarn);WFO0003</NoWarn>
		<Version>0.3.1</Version>
		<Product>DesktopTwin 桌面分身</Product>
		<AssemblyTitle>DesktopTwin 桌面分身</AssemblyTitle>
		<Description>把 Windows 自带的第二个桌面会话（RDP Child Session）变成桌面上的一个窗口。</Description>
		<Company>DesktopTwin contributors</Company>
		<Copyright>Copyright (C) 2026 DesktopTwin contributors</Copyright>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
		<PackageReference Include="WPF-UI" Version="4.2.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 同时作为 WPF 资源嵌入：窗口图标与托盘图标从这里读，避免依赖 exe 的 Win32 图标资源 -->
		<Resource Include="Assets\DesktopTwin.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- 让测试能直接调用 internal 的安全守卫，而不必把它们提升成公共 API -->
		<InternalsVisibleTo Include="DesktopTwin.Tests" />
		<Compile Include="..\Shared\SessionLaunchProtocol.cs" Link="Launching\SessionLaunchProtocol.cs" />
	</ItemGroup>

	<!-- 一次性会话启动代理：使用 Windows 自带 Framework 编译器，不常驻、不安装自启项。 -->
	<Target Name="BuildSessionLaunch" BeforeTargets="PrepareForBuild">
		<PropertyGroup>
			<SessionLaunchSource>$(MSBuildThisFileDirectory)..\SessionLaunchWorker\SessionLaunchProgram.cs</SessionLaunchSource>
			<SessionLaunchWorkerSource>$(MSBuildThisFileDirectory)..\SessionLaunchWorker\SessionLaunchWorker.cs</SessionLaunchWorkerSource>
			<SessionLaunchProtocolSource>$(MSBuildThisFileDirectory)..\Shared\SessionLaunchProtocol.cs</SessionLaunchProtocolSource>
			<SessionLaunchManifest>$(MSBuildThisFileDirectory)..\SessionLaunchWorker\app.manifest</SessionLaunchManifest>
			<SessionLaunchIcon>$(MSBuildProjectDirectory)\Assets\DesktopTwin.ico</SessionLaunchIcon>
			<SessionLaunchOutput>$(IntermediateOutputPath)DesktopTwin.LaunchWorker.exe</SessionLaunchOutput>
			<SessionLaunchCompiler>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe</SessionLaunchCompiler>
			<SessionLaunchCompiler Condition="!Exists('$(SessionLaunchCompiler)')">$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe</SessionLaunchCompiler>
		</PropertyGroup>

		<Error Condition="!Exists('$(SessionLaunchCompiler)')"
		       Text="找不到 .NET Framework 的编译器，无法构建程序启动代理。" />
		<MakeDir Directories="$(IntermediateOutputPath)" />
		<Exec Command="&quot;$(SessionLaunchCompiler)&quot; /nologo /warn:4 /warnaserror+ /target:winexe /optimize+ /win32manifest:&quot;$(SessionLaunchManifest)&quot; /win32icon:&quot;$(SessionLaunchIcon)&quot; /out:&quot;$(SessionLaunchOutput)&quot; /reference:System.dll /reference:System.Core.dll &quot;$(SessionLaunchSource)&quot; &quot;$(SessionLaunchWorkerSource)&quot; &quot;$(SessionLaunchProtocolSource)&quot;" />

		<ItemGroup>
			<EmbeddedResource Include="$(SessionLaunchOutput)" LogicalName="DesktopTwin.LaunchWorker.exe" />
		</ItemGroup>
	</Target>

</Project>

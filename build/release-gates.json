  },
  "WATCH001": {
    "description": "Queued cancellation cannot read disposed sources; watcher generations drain sequentially and every fault is observed.",
    "tests": [
      "DesktopTwin.Tests.CredentialDialogWatchTests.StoppingBeforeQueuedWorkStartsDoesNotUseADisposedSource",
